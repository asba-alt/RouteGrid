# RouteGrid Development Environment Variables
# Copy to `.env` and adjust. `.env` is gitignored — never commit real secrets.

# Database (PostgreSQL + PostGIS) — async driver for FastAPI
DATABASE_URL=postgresql+asyncpg://routegrid:routegrid_dev@localhost:5432/routegrid

# Alembic and standalone scripts use a sync driver for migrations
DATABASE_URL_SYNC=postgresql+psycopg2://routegrid:routegrid_dev@localhost:5432/routegrid

# Redis — cache for current vehicle positions only
REDIS_URL=redis://localhost:6379/0

# Batch optimization trigger policy
BATCH_SIZE=10
BATCH_TIMEOUT_SECONDS=15

# Solver budget per optimization pass (local-search gains are tiny on demo-scale data,
# so a large budget is wasted wall-clock time)
OPTIMIZER_TIME_LIMIT_SECONDS=2

# Simulation (FR-29 travel-time approximation, FR-33 time compression)
SPEED_FACTOR_KMH=40
TIME_COMPRESSION_RATIO=60

# Warehouse selection heuristic weights (reserved for a later phase)
WEIGHT_DISTANCE=0.4
WEIGHT_WORKLOAD=0.3
WEIGHT_DELIVERY_TIME=0.3

# App
APP_ENV=development
DEBUG=true

# Browser origins allowed to call the API (comma-separated).
# Empty in development → falls back to the Vite dev server origins.
# REQUIRED in production: an empty value fails closed and blocks browser calls.
CORS_ORIGINS=

# --- Authentication ---
# Sessions are HttpOnly cookies issued by the backend. No key ships to the browser.
# Generate a hash with: python -m scripts.make_password_hash
SESSION_SECRET=
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=
SESSION_TTL_MINUTES=480
# lax = frontend proxies /api (same-origin); none = cross-site API over HTTPS
COOKIE_SAMESITE=lax

# Minutes before an inventory hold expires. 0 = never expire.
RESERVATION_TTL_MINUTES=0
