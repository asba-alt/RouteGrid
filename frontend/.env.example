# Base URL of the RouteGrid API.
# Leave empty in development to use the Vite dev-server proxy.
# In production set this to the deployed backend origin, e.g.
#   VITE_API_BASE_URL=https://routegrid-api.onrender.com
VITE_API_BASE_URL=

# No API key or secret belongs here. Authentication is handled by an HttpOnly
# session cookie issued by the backend, so nothing sensitive ships to the browser.
